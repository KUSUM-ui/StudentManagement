<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Home</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;

    background: linear-gradient(to right, #d16ba5, #c777b9, #ba83ca, #aa8fd8);
    height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;
}

/* Card */
.container {
    background: #f3f3f3;
    padding: 40px;
    border-radius: 12px;
    width: 400px;
    text-align: center;

    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

/* Heading */
h1 {
    margin-bottom: 10px;
}

/* Text */
p {
    color: #555;
    margin-bottom: 10px;
}
</style>

</head>
<body>

<div class="container">
    <h1>Lets get Started</h1>
    <p>Welcome to the home page</p>
</div>

</body>
</html>